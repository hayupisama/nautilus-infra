# Environnement local Nautilus : MODELE, sans aucune valeur sensible.
#
# Mode d'emploi pour qui clone le projet :
#   1. Copier ce fichier :  cp .env.example .env
#   2. Remplir chaque variable vide ci-dessous dans .env (valeurs de votre choix, propres a votre poste).
#      Exemple pour generer une valeur aleatoire :  openssl rand -hex 16
#   3. Ne JAMAIS commiter .env (il est ignore par git) et ne jamais mettre de valeur dans ce modele.
#
# docker compose refuse de demarrer tant qu'une variable obligatoire est vide.
# Recette/production : secrets chiffres SOPS uniquement (voir secrets/), jamais ce fichier.

# --- PostgreSQL + PostGIS (base applicative de l'API) ---
POSTGRES_PORT=5432
POSTGRES_DB=nautilus
# A remplir : nom de l'utilisateur proprietaire de la base applicative
POSTGRES_USER=
# A remplir
POSTGRES_PASSWORD=

# --- Base de Keycloak (meme serveur PostgreSQL, base et utilisateur dedies) ---
KEYCLOAK_DB_NAME=keycloak
# A remplir : nom de l'utilisateur de la base Keycloak (different de POSTGRES_USER)
KEYCLOAK_DB_USER=
# A remplir
KEYCLOAK_DB_PASSWORD=

# --- Keycloak ---
KEYCLOAK_PORT=8180
KEYCLOAK_MANAGEMENT_PORT=9000
# A remplir : compte d'administration de la console (realm master)
KEYCLOAK_ADMIN_USER=
# A remplir
KEYCLOAK_ADMIN_PASSWORD=

# --- Comptes de test du realm nautilus (passenger1, booker1, driver1, admin1) ---
# A remplir : mot de passe commun des comptes de test, injecte a l'import du realm.
# Apres un changement : reinitialiser (docker compose down -v) pour reimporter le realm.
KEYCLOAK_TEST_USERS_PASSWORD=
