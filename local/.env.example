# Environnement local Nautilus : valeurs de DEVELOPPEMENT, factices.
# Copier ce fichier en .env (ignore par git) : cp .env.example .env
# Ne jamais y mettre de valeur reelle (recette/production : secrets SOPS, voir secrets/).

# PostgreSQL + PostGIS (base applicative de l'API)
POSTGRES_PORT=5432
POSTGRES_DB=nautilus
POSTGRES_USER=nautilus
POSTGRES_PASSWORD=changeme-nautilus-dev

# Base de Keycloak (meme serveur PostgreSQL, base et utilisateur dedies)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme-keycloak-dev

# Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-admin-dev
